{
  "name": "brewmaster",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node --watch backend/src/app.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "start": "node backend/src/app.js",
    "test:api": "node backend/src/test-api.js",
    "build": "npm --prefix frontend run build"
  },
  "dependencies": {
    "sql.js": "^1.12.0",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
