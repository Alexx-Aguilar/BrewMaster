{
  "info": { "name": "BrewMaster API", "description": "Pruebas CRUD del sistema empresarial BrewMaster", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:4000/api" }],
  "item": [
    { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/health" } },
    { "name": "Listar insumos", "request": { "method": "GET", "url": "{{baseUrl}}/insumos" } },
    { "name": "Crear insumo", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Malta Munich\",\n  \"tipo\": \"Malta\",\n  \"proveedor\": \"Maltería Central\",\n  \"stock_kg\": 35,\n  \"unidad\": \"kg\"\n}" }, "url": "{{baseUrl}}/insumos" } },
    { "name": "Listar lotes", "request": { "method": "GET", "url": "{{baseUrl}}/lotes" } },
    { "name": "Listar barriles", "request": { "method": "GET", "url": "{{baseUrl}}/barriles" } }
  ]
}
